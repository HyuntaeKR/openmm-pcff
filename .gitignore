# Personal files
CLAUDE.md
mydocs/
.vscode

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Scratch output from LAMMPS runs outside reference/
log.cite

# Third-party material from EMC
reference/emc.pdf

# Reference data: only the EMC inputs (input.esh) are tracked.
# Everything else is EMC or LAMMPS output (EMC- and PCFF-derived data), regenerated by the scripts in scripts/.
reference/*/*
!reference/*/input.esh

# Benchmark by-products (regenerable; not used by the code)
benchmark/*/build.emc
benchmark/*/*.in
benchmark/*/*.emc.gz
benchmark/*/*.pdb.gz
benchmark/*/*.psf.gz
benchmark/*/*.vmd
benchmark/*/accuracy/*/forces.dump

# Benchmark data derived from EMC and PCFF (structures, parameters, LAMMPS logs that echo the parameters) and large files
benchmark/**/*.data
benchmark/**/*.params
benchmark/**/*.dump
benchmark/**/log.lammps
