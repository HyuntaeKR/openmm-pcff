# Speed benchmark, written by scripts/benchmark_lammps.py
units		real
atom_style	full
boundary	p p p
read_data	../../relax/relaxed.data
include		../../pmma_50k.params
kspace_style	pppm 0.001
timestep	1.0
fix		integration all nve
thermo_style	custom step temp pe etotal press density
thermo		1000
run		1000
run		5000
