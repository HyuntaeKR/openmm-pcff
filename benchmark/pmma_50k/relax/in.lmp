# Compression and relaxation of the EMC build, written by scripts/make_benchmark_systems.py
units		real
atom_style	full
boundary	p p p
read_data	../pmma_50k.data
include		../pmma_50k.params
kspace_style	pppm 0.001
thermo_style	custom step temp pe ebond eangle evdwl ecoul elong press density
thermo		1000

# 1. Remove close contacts of the EMC build.
minimize	1.0e-4 1.0e-6 1000 10000
reset_timestep	0
timestep	1.0
velocity	all create 300.0 2026 dist gaussian rot yes mom yes
fix		temperature all langevin 300.0 300.0 100 2026
fix		integration all nve/limit 0.2
run		1000
unfix		integration

# 2. Compress from 0.5 to 1.2 g/cm^3 (box lengths x 0.746901).
fix		integration all nve
fix		compression all deform 1 x scale 0.7469007911 y scale 0.7469007911 z scale 0.7469007911 remap x
run		50000
unfix		compression
unfix		integration
unfix		temperature

# 3. Nose-Hoover NVT at the target density.
fix		nvt all nvt temp 300.0 300.0 100
run		10000

write_data	relaxed.data nocoeff
write_dump	all custom relaxed_positions.dump id xu yu zu modify sort id format float %.10g
