# NVE drift, written by scripts/check_benchmark_nve_drift.py
units		real
atom_style	full
boundary	p p p
read_data	../relax/relaxed.data
include		../pmma_50k.params
kspace_style	pppm 0.001
timestep	1.0
fix		integration all nve
thermo		100
thermo_style	custom step time pe ke etotal temp
thermo_modify	format float %.15g
run		20000
