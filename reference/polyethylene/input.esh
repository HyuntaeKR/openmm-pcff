# EMC chemistry file: polyethylene melt reference system for PCFF (LAMMPS vs OpenMM).
#
# Prepare (from this directory):
#   emc.pl input.esh                              -> build.emc, polyethylene.in
#   emc_linux_x86_64 build.emc 2>&1 | tee build.out  -> polyethylene.data, polyethylene.params, polyethylene.pdb, polyethylene.psf
#
# Notes:
# - Columns are separated by tabs; the EMC manual (Sec. 4.5.2) allows only tabs or commas.
# - No field_location: EMC uses its own PCFF files (EMC_ROOT/field/cff/pcff, the default field location).
# - Chain: CH3-(CH2-CH2)20-CH3 = C42H86 = 20 x 6 + 2 x 4 = 128 atoms.
# - ntotal 1280 = 10 chains x 128 atoms.
# - density 0.5 g/cc (same as the butane reference) gives a cubic box of about 27.0 Angstrom, larger than 2 x 9.5 Angstrom cutoff.
# - The extended chain (about 52 Angstrom) is longer than the box, so bonded terms cross periodic boundaries.
# - Group layout follows EMC v9.4.4 examples/setup/chemistry/polymer/homopolymer.
# - Cutoffs, Ewald, and kspace precision are left at emc.pl PCFF defaults (pair 9.5, charge 9.5, pppm/cg 0.001).

ITEM	OPTIONS

project	polyethylene
seed	2026

replace	true
build_dir	.
field	pcff
field_id	pcff
density	0.5
ntotal	1280

ITEM	END

# Groups: ethyl is the -CH2-CH2- repeat unit, methyl is the CH3 end cap.
# "1,ethyl:2" connects connection point 1 of this group to connection point 2 of ethyl.

ITEM	GROUPS

ethyl	*CC*	1	ethyl:2
methyl	*C	1	ethyl:1	1	ethyl:2

ITEM	END

ITEM	CLUSTERS

poly	alternate	1

ITEM	END

# One chain length only: 20 ethyl repeat units and 2 methyl caps.

ITEM	POLYMERS

poly
1	ethyl	20	methyl	2

ITEM	END
