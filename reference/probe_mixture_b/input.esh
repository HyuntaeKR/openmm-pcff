# EMC chemistry file, written by scripts/make_emc_reference.py (reference: EMC typing and parameters).
#
# Prepare (from this directory):
#   emc.pl input.esh                              -> build.emc
#   emc_linux_x86_64 build.emc                    -> probe_mixture_b.data, probe_mixture_b.params
#
# Notes:
# - Columns are separated by tabs (EMC manual, Sec. 4.5.2).
# - No field_location: EMC uses its own PCFF files (EMC_ROOT/field/cff/pcff, the default field location).
# - Mixture of many small molecules with equal mole fractions, used to compare typing and parameter lookup (including automatic parameters) with EMC.

ITEM	OPTIONS

project	probe_mixture_b
seed	2026

replace	true
build_dir	.
field	pcff
field_id	pcff
density	0.5
ntotal	2340

ITEM	END

ITEM	GROUPS

pyrrole	c1cc[nH]c1
imidazole	c1cnc[nH]1
oxazole	c1cocn1
aceticacid	CC(=O)O
benzoicacid	OC(=O)c1ccccc1
formaldehyde	C=O
butadiene	C=CC=C
allene	C=C=C
acetylene	C#C
propyne	CC#C
carbondisulfide	S=C=S
cyclopropane	C1CC1
cyclobutane	C1CCC1
cyclopentane	C1CCCC1
cyclohexane	C1CCCCC1
oxirane	C1CO1
oxetane	C1COC1
thf	C1CCOC1
dioxane	C1COCCO1
aziridine	C1CN1
trimethylsilanol	C[Si](C)(C)O
hexamethylcyclotrisiloxane	C[Si]1(C)O[Si](C)(C)O[Si](C)(C)O1
tetrafluoromethane	FC(F)(F)F
trifluorotoluene	FC(F)(F)c1ccccc1
iodomethane	CI
bromoethane	CCBr
ethanethiol	CCS
diphenylether	c1ccc(Oc2ccccc2)cc1
biphenyl	c1ccc(-c2ccccc2)cc1
naphthalene	c1ccc2ccccc2c1
cyclohexene	C1=CCCCC1
methylamine	CN
dimethylamine	CNC
tetrafluoroethylene	FC(F)=C(F)F
methanol	CO
ethylene	C=C
isobutylene	CC(C)=C
methylmethacrylate	CC(=C)C(=O)OC
phenylacetylene	C#Cc1ccccc1

ITEM	END

